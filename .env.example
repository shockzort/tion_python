# Easy Breezy — конфигурация (скопируйте в .env и заполните).
# Все переменные сервера имеют префикс EB_.

# ── Сервер ──────────────────────────────────────────────────────────────
EB_HOST=0.0.0.0
EB_PORT=8000
EB_LOG_LEVEL=INFO
# Каталог логов; пусто — только stdout/journald
#EB_LOG_DIR=logs
# Каталог данных (SQLite, бэкапы)
EB_DATA_DIR=data
# Таймзона автоматизации/бэкапов (IANA-имя). По умолчанию системная;
# в docker-контейнере системная = UTC — задавать обязательно.
#EB_TIMEZONE=Europe/Moscow

# ── Фаза 1: BLE ─────────────────────────────────────────────────────────
# Dev-режим без железа: поднять N фейковых бризеров
#EB_FAKE_DEVICES=3

# ── Командная шина ──────────────────────────────────────────────────────
# Окно ручного управления: автоматика в нём не перебивает владельца
#EB_MANUAL_HOLD_MINUTES=60
# Сколько команда ждёт возвращения бризера в эфир, прежде чем упасть.
# Линк рвётся регулярно, а отказ выжигает ключ идемпотентности — без
# ожидания расписание навсегда теряет отвалившееся устройство.
#EB_COMMAND_OFFLINE_GRACE_SECONDS=180
# Смена фильтров S4: проверенный ресурс после сброса, по UUID бризера.
# Пустой объект — кнопка выключена. null — только для полевой проверки.
#EB_FILTER_RESET_DAYS={}

# ── Фаза 4: Умный дом Яндекса (заполняется при настройке навыка) ────────
#EB_YANDEX_CLIENT_ID=
#EB_YANDEX_CLIENT_SECRET=
#EB_YANDEX_SKILL_ID=
#EB_YANDEX_CALLBACK_TOKEN=

# ── Фаза 6: датчики ─────────────────────────────────────────────────────
#EB_MAGICAIR_EMAIL=
#EB_MAGICAIR_PASSWORD=
# Брокер датчиков (Mosquitto, профиль mqtt — deploy/ansible/README.md)
#EB_MQTT_URL=mqtt://easy-breezy:<пароль>@127.0.0.1:1883
